{
  "name": "browser-extension-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsc --project tsconfig.server.json",
    "dev:extension": "vite",
    "start": "npm run build:server && node dist/server.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
