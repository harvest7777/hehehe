{
  "manifest_version": 3,
  "name": "Hello World Extension",
  "version": "1.0.0",
  "description": "A starter Chrome extension that says hello.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open browser side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  }
}
